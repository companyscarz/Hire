APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/scarz_pos
PORT=8000
# Nylon Pay credentials; configure these in your hosting environment, never in source control.
NYLONPAY_API_KEY=
NYLONPAY_API_SECRET=
NYLONPAY_WEBHOOK_SECRET=
# Server-side subscription prices in UGX. Set these before enabling paid subscriptions.
SCARZ_POS_PLAN_MONTHLY_UGX=
SCARZ_POS_PLAN_QUARTERLY_UGX=
SCARZ_POS_PLAN_ANNUAL_UGX=
PUBLIC_BASE_URL=http://127.0.0.1:5000
