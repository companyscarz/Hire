      "icons": [
        {
          "src": "/static/icons/hire-icon-192.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Open workspace",
      "short_name": "Workspace",
      "url": "/dashboard",
      "icons": [
        {
          "src": "/static/icons/hire-icon-192.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    }
  ]
