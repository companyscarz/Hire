# Copy to .env for local development. Never commit .env or real credentials.
APP_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-long-random-secret

# PostgreSQL is the intended source of truth for Hire Cloud.
# Install psycopg and use the same value in DATABASE_URL.
DATABASE_URL=postgresql+psycopg://hire_app:replace-me@localhost:5432/hire_cloud

# Optional legacy integrations; rotate any values that were previously committed.
CODE_1=
CODE_2=
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=
OPENAI_API_KEY=
MAPBOX_PUBLIC_TOKEN=

# Future platform integrations. Keep secrets server-side and scope credentials narrowly.
DOKPLOY_BASE_URL=
DOKPLOY_API_KEY=
GIT_PROVIDER_CLIENT_ID=
GIT_PROVIDER_CLIENT_SECRET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Email delivery
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
